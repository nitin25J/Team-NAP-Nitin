# Varuna AI Backend Environment Configuration

# Server Port
PORT=8000

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./app/database/varuna.db

# CORS Allowed Origins (Comma-separated or * for development)
CORS_ORIGINS=*

# Weather API (Using Open-Meteo free public API, no key required)
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast
