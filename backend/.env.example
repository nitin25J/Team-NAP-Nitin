# Varuna AI Backend — Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=8000
DEBUG=false

# Database (defaults to SQLite for development)
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./app/database/varuna.db

# CORS
CORS_ORIGINS=*

# Weather API (Open-Meteo is free, no key required)
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast

# AI Provider: "rule-based" | "gemini" | "openai"
AI_PROVIDER=rule-based
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
